# Application Environment Configuration
# Localhost-only configuration - ZERO-COST GUARANTEE

# Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./data/database/facebook_agent.db

# Local Ollama AI Engine (Port 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=60

# Facebook Graph API (Official Meta App Credentials)
# Leave blank during Phase 1 - 4
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Media Storage
MEDIA_DIR=./data/media
BACKUP_DIR=./data/backups
EXPORTS_DIR=./data/exports

# Security & Limits
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=25
